{
  "expo": {
    "name": "sunshine-patrol",
    "slug": "sunshine-patrol",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/logo.png",
    "scheme": "sunshinesecurityapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./src/assets/logo.png",
      "bundleIdentifier": "com.rafedesigns.sunshinesecurity",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.rafedesigns.sunshinesecurity",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./src/assets/logo.png",
        "backgroundImage": "./src/assets/logo.png",
        "monochromeImage": "./src/assets/logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "INTERNET",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./src/assets/logo.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./src/assets/logo.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Sunshine Security to verify perimeter watch and guard geofencing."
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "c2823474-f3e7-44fc-82f4-a22fd0d84958"
      }
    }
  }
}